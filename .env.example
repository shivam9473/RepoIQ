# CodeAtlas AI — Environment Variables
# Copy to .env and fill in your keys

NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://codeatlas:codeatlas@localhost:5432/codeatlas

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI (optional — preferred for code embeddings)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
EMBEDDING_PROVIDER=openai

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=codeatlas
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Repo clone path
REPOS_PATH=./repos

# Service ports
BACKEND_PORT=4000
EMBEDDING_SERVICE_PORT=4001
VECTOR_SERVICE_PORT=4002
AI_SERVICE_PORT=4003
